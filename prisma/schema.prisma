generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

enum CheckInStatus {
  NOT_CHECKED_IN
  CHECKED_IN
}

enum CheckInMethod {
  QR_CODE
  MANUAL_CODE
  PHONE
}

enum CheckInLogStatus {
  SUCCESS
  ALREADY_CHECKED_IN
  NOT_FOUND
  INVALID
  NOT_STARTED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELED
  FAILED
  REFUNDED
}

enum PaymentProduct {
  EVENT_CREDIT
  ATTENDEE_CREDIT
}

enum Gender {
  M
  F
  OTHER
}

enum CreditTransactionReason {
  PAYMENT_TOPUP
  ATTENDEE_CREATE
  ATTENDEE_IMPORT
  MANUAL_ADJUSTMENT
  FEATURE_UNLOCK
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  role            UserRole  @default(ADMIN)
  attendeeCredits Int       @default(0)
  assignedEventId String?
  assignedEvent   Event?    @relation("EventStaff", fields: [assignedEventId], references: [id], onDelete: SetNull)
  staffAssignments EventStaffAssignment[]
  events          Event[]   @relation("EventCreator")
  payments        Payment[]
  creditTransactions CreditTransaction[]
  importSessions  ImportSession[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Event {
  id                   String       @id @default(cuid())
  name                 String
  slug                 String       @unique
  description          String?
  content              String?
  startAt              DateTime
  endAt                DateTime?
  location             String?
  logoUrl              String?
  coverImageUrl        String?
  attendeeLimit        Int?
  allowOverCapacity    Boolean      @default(false)
  registrationRequired Boolean      @default(false)
  openRegistration     Boolean      @default(false)
  selfCheckInBufferMinutes Int?
  venueCode            String       @default(uuid())
  registrationFields   Json         @default("[]")
  unlockedFeatures     String[]     @default([])
  // 主辦手動暫停「新增公開報名」；既有參加者的報到、查詢完全不受影響
  publicRegistrationPausedAt   DateTime?
  publicRegistrationPausedById String?
  // 最近一次寄出異常告警的時間，用來做冷卻去重
  lastAbuseAlertAt             DateTime?
  abuseEvents          AbuseEvent[]
  createdById          String
  createdBy            User         @relation("EventCreator", fields: [createdById], references: [id])
  attendees            Attendee[]
  importSessions       ImportSession[]
  checkInLogs          CheckInLog[]
  survey               Survey?
  staffMembers         User[]       @relation("EventStaff")
  staffAssignments     EventStaffAssignment[]
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model EventStaffAssignment {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

model Attendee {
  id              String           @id @default(cuid())
  eventId         String
  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name            String
  phone           String
  email           String?
  age             Int?
  gender          Gender?
  checkInCode     String
  qrToken         String
  checkInStatus   CheckInStatus    @default(NOT_CHECKED_IN)
  checkedInAt     DateTime?
  customFields      Json?
  note              String?
  checkInCapacity   Int              @default(1)
  checkInCount      Int              @default(0)
  // 公開報名時由瀏覽器產生的隨機請求識別碼，只用於重試防重，與身份辨識無關
  registrationKey String?
  checkInLogs     CheckInLog[]
  surveyResponses SurveyResponse[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([eventId, checkInCode])
  @@unique([eventId, qrToken])
  @@unique([eventId, registrationKey])
  @@index([eventId, name])
  @@index([eventId, phone])
}

model CheckInLog {
  id          String           @id @default(cuid())
  eventId     String
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendeeId  String?
  attendee    Attendee?        @relation(fields: [attendeeId], references: [id], onDelete: SetNull)
  method      CheckInMethod
  status      CheckInLogStatus
  checkedInAt DateTime?
  createdAt   DateTime         @default(now())

  @@index([eventId, createdAt])
  @@index([attendeeId])
}

model Payment {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String         @default("newebpay")
  product         PaymentProduct @default(ATTENDEE_CREDIT)
  status          PaymentStatus  @default(PENDING)
  quantity        Int            @default(1)
  creditsGranted  Int            @default(0)
  amountTotal     Int?
  currency        String?        @default("TWD")
  pricingTier     String?
  attendeeLimit   Int?
  providerOrderNo String?        @unique
  providerTradeNo String?        @unique
  checkoutUrl     String?
  returnTo        String?
  consumedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([consumedAt])
}

model CreditTransaction {
  id           String                  @id @default(cuid())
  userId       String
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int
  reason       CreditTransactionReason
  balanceAfter Int
  eventId      String?
  attendeeId   String?
  paymentId    String?
  importSessionId String?
  note         String?
  createdAt    DateTime                @default(now())

  @@index([userId, createdAt])
  @@index([importSessionId])
}

model Survey {
  id        String           @id @default(cuid())
  eventId   String           @unique
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title     String           @default("活動問卷")
  sentAt    DateTime?
  questions SurveyQuestion[]
  responses SurveyResponse[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model SurveyQuestion {
  id       String   @id @default(cuid())
  surveyId String
  survey   Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  question String
  type     String   @default("text")
  options  String[]
  order    Int      @default(0)
}

model SurveyResponse {
  id         String    @id @default(cuid())
  surveyId   String
  survey     Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  attendeeId String?
  attendee   Attendee? @relation(fields: [attendeeId], references: [id], onDelete: SetNull)
  answers    Json
  createdAt  DateTime  @default(now())

  @@index([surveyId])
  @@index([attendeeId])
}

enum ImportSessionStatus {
  PREVIEW
  CONFIRMED
}

// 名單匯入的預覽／確認流程。PREVIEW 期間暫存解析後的名單（含個資），
// 確認完成或逾期後會清空 rows，只保留結果摘要供使用者查詢匯入歷史。
model ImportSession {
  id          String              @id @default(cuid())
  eventId     String
  event       Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName    String
  fileHash    String
  status      ImportSessionStatus @default(PREVIEW)
  rows        Json
  rowErrors   Json
  decisions   Json                @default("{}")
  result      Json?
  expiresAt   DateTime
  confirmedAt DateTime?
  createdAt   DateTime            @default(now())

  @@index([eventId, createdAt])
  @@index([status, expiresAt])
}

// 共享、會過期的固定視窗計數器，用於公開入口的速率限制與告警門檻（Vercel 無共用記憶體，故存資料庫）
model RateLimitCounter {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}

enum AbuseEventType {
  RATE_ALERT_EVENT
  RATE_ALERT_IP
  RATE_LIMITED
  CAPTCHA_FAILED
  REGISTRATION_PAUSED
  REGISTRATION_RESUMED
}

// 公開報名的異常與稽核紀錄；來源 IP 只存雜湊，不存原始 IP
model AbuseEvent {
  id          String         @id @default(cuid())
  eventId     String
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type        AbuseEventType
  detail      Json?
  actorUserId String?
  notified    Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@index([eventId, createdAt])
}

// 排程維護工作（例如清理過期暫存）的執行紀錄，供查核每次清了多少、是否成功
model MaintenanceRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  result     Json?

  @@index([job, startedAt])
}
