{
  "installCommand": "yarn install",
  "buildCommand": "yarn vercel-build",
  "functions": {
    "api/index.cjs": {
      "maxDuration": 30
    }
  },
  "crons": [{ "path": "/internal/cron/maintenance", "schedule": "0 19 * * *" }],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
